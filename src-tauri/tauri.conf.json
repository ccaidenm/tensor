{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tensor",
  "version": "0.1.0",
  "identifier": "com.aestriex.word-processor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tensor",
        "maximized": true,
        "visible": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/translate-models/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Caiden",
    "category": "Productivity",
    "copyright": "\u00a9 2026 Caiden",
    "shortDescription": "A paginated word processor",
    "longDescription": "Tensor \u2014 a paginated, engine-driven word processor with sections, columns, headers and footers, tables, images, equations, and native print, PDF, DOCX, and Markdown round trips.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}